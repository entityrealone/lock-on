-- Cleanup function to reset character state
local function cleanupLock()
    lockedTargetPart = nil

    if activeGyro then
        activeGyro:Destroy()
        activeGyro = nil
    end

    if LOCAL_PLAYER.Character and LOCAL_PLAYER.Character:FindFirstChildOfClass("Humanoid") then
        LOCAL_PLAYER.Character:FindFirstChildOfClass("Humanoid").AutoRotate = true
    end
end

-- Slider Drag Logic (Supports Mouse & Touch)
local draggingSlider = false

local function updateSlider(input)
    local posRel = math.clamp(
        (input.Position.X - sliderTrack.AbsolutePosition.X) / sliderTrack.AbsoluteSize.X,
        0,
        1
    )

    sliderFill.Size = UDim2.new(posRel, 0, 1, 0)
    settings.Sensitivity = math.round((posRel * 2.0) * 100) / 100
    sensLabel.Text = "Sensitivity: " .. tostring(settings.Sensitivity) .. " (Max: 2.0)"

    -- Update gyro power immediately when slider changes (optimized)
    if activeGyro then
        activeGyro.P = 25000 + (settings.Sensitivity / 2.0) * 125000
    end
end

sliderTrack.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        draggingSlider = true
        updateSlider(input)
    end
end)

UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        draggingSlider = false
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if draggingSlider and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
        updateSlider(input)
    end
end)

-- Function to acquire the closest target within MaxDistance
local function acquireClosestTarget()
    local bestTarget = nil
    local myChar = LOCAL_PLAYER.Character

    if not myChar or not myChar:FindFirstChild("HumanoidRootPart") then
        return nil
    end

    local myRootPos = myChar.HumanoidRootPart.Position
    local shortestDistance = settings.MaxDistance

    for _, v in ipairs(Players:GetPlayers()) do
        if v ~= LOCAL_PLAYER and v.Character then
            local rootPart = v.Character:FindFirstChild("HumanoidRootPart") or v.Character.PrimaryPart
            local humanoid = v.Character:FindFirstChildOfClass("Humanoid")

            if rootPart and humanoid and humanoid.Health > 0 then
                local distance = (rootPart.Position - myRootPos).Magnitude

                if distance < shortestDistance then
                    shortestDistance = distance
                    bestTarget = rootPart
                end
            end
        end
    end

    return bestTarget
end

-- Clickable Toggle Button Activation Logic
toggleBtn.Activated:Connect(function()
    settings.Enabled = not settings.Enabled

    if settings.Enabled then
        lockedTargetPart = acquireClosestTarget()

        if lockedTargetPart then
            toggleBtn.Text = "Lock-On: ON"
            toggleBtn.TextColor3 = Color3.fromRGB(120, 255, 170)
            toggleBtn.BackgroundColor3 = Color3.fromRGB(30, 70, 50)
            status.Text = "Status: Locked"
        else
            settings.Enabled = false
            toggleBtn.Text = "Lock-On: OFF"
            status.Text = "Status: No target nearby"
        end
    else
        toggleBtn.Text = "Lock-On: OFF"
        toggleBtn.TextColor3 = Color3.fromRGB(255, 120, 120)
        toggleBtn.BackgroundColor3 = Color3.fromRGB(50, 70, 50)
        status.Text = "Status: Unlocked"
        cleanupLock()
    end
end)

-- Handle Character Death / Respawn UI sync
LOCAL_PLAYER.CharacterAdded:Connect(function(char)
    settings.Enabled = false
    toggleBtn.Text = "Lock-On: OFF"
    toggleBtn.TextColor3 = Color3.fromRGB(255, 120, 120)
    toggleBtn.BackgroundColor3 = Color3.fromRGB(50, 70, 50)
    status.Text = "Status: Ready"
    cleanupLock()
end)

-- Performance-Optimized Tracking Loop
RunService.RenderStepped:Connect(function(dt)
    if not settings.Enabled or not lockedTargetPart then
        return
    end

    local myChar = LOCAL_PLAYER.Character

    if not myChar or not myChar:FindFirstChild("HumanoidRootPart") or not myChar:FindFirstChildOfClass("Humanoid") then
        cleanupLock()
        return
    end

    local myRoot = myChar.HumanoidRootPart
    local humanoid = myChar:FindFirstChildOfClass("Humanoid")

    if humanoid.Health <= 0 or not lockedTargetPart.Parent or not lockedTargetPart.Parent:FindFirstChildOfClass("Humanoid") or lockedTargetPart.Parent:FindFirstChildOfClass("Humanoid").Health <= 0 then
        settings.Enabled = false
        toggleBtn.Text = "Lock-On: OFF"
        toggleBtn.TextColor3 = Color3.fromRGB(255, 120, 120)
        toggleBtn.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
        status.Text = "Status: Target lost"
        cleanupLock()
        return
    end

    humanoid.AutoRotate = false

    if not activeGyro or activeGyro.Parent ~= myRoot then
        if activeGyro then
            activeGyro:Destroy()
        end

        activeGyro = Instance.new("BodyGyro")
        activeGyro.Name = "LockOnGyro"
        activeGyro.MaxTorque = Vector3.new(0, math.huge, 0)
        -- Set initial power based on sensitivity
        activeGyro.P = 25000 + (settings.Sensitivity / 2.0) * 125000
        activeGyro.Parent = myRoot
    end

    local targetPos = lockedTargetPart.Position + Vector3.new(0, 0.5, 0)
    local horizontalTargetPos = Vector3.new(
        targetPos.X,
        myRoot.Position.Y,
        targetPos.Z
    )

    -- Minimum-distance buffer check (1.5 studs)
    local currentDist = (myRoot.Position - horizontalTargetPos).Magnitude

    if currentDist < settings.MinDistance then
        local pushDirection = (myRoot.Position - horizontalTargetPos).Unit
        local safePos = horizontalTargetPos + (pushDirection * settings.MinDistance)

        myRoot.AssemblyLinearVelocity = Vector3.new(
            0,
            myRoot.AssemblyLinearVelocity.Y,
            0
        )

        myRoot.CFrame = CFrame.new(
            Vector3.new(safePos.X, myRoot.Position.Y, safePos.Z),
            horizontalTargetPos
        )
    end

    -- Character Body Rotation
    activeGyro.CFrame = CFrame.new(myRoot.Position, horizontalTargetPos)

    -- Centered POV Camera Framing
    local myPos = myRoot.Position + Vector3.new(0, 2.5, 0)
    local directionToTarget = (targetPos - myPos).Unit
    local zoomDistance = (camera.CFrame.Position - myRoot.Position).Magnitude

    if zoomDistance < 3 then
        zoomDistance = 10
    end

    local centeredCamPos = myPos - (directionToTarget * zoomDistance)
    local targetCamCFrame = CFrame.new(centeredCamPos, targetPos)

    if settings.Sensitivity >= 2.0 then
        camera.CFrame = targetCamCFrame
    else
        local alpha = math.clamp(
            (settings.Sensitivity / 2.0) * (dt * 60),
            0.01,
            1
        )

        camera.CFrame = camera.CFrame:Lerp(targetCamCFrame, alpha)
    end
end)
